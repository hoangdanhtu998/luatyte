{"id":"con-tro-co-ban","tieuDe":"Con trỏ và mũi tên","baiHoc":"Con trỏ","moTaNgan":"Con trỏ p giữ địa chỉ của x; *p đọc và ghi thẳng vào x.","chuanC":true,"maNguon":["#include <stdio.h>","int main(void) {","    int x = 10;","    int *p = &x;","    *p = 25;","    printf(\"%d\\n\", x);","    return 0;","}"],"buoc":[{"dong":0,"moTa":"Chưa chạy dòng nào. Bấm \"Bước tiếp\" để chạy từng dòng. (Địa chỉ trên màn hình chỉ là số minh họa, không phải địa chỉ thật.)","stack":[],"heap":[],"mauTen":[],"dauRa":""},{"dong":3,"moTa":"Tạo biến x kiểu int và gán 10. x nằm trên stack.","stack":[{"id":"x","ten":"x","kieu":"int","giaTri":10,"dia":"0x1000","khung":"main"}],"heap":[],"mauTen":[],"dauRa":""},{"dong":4,"moTa":"Tạo con trỏ p và gán &x. p không chứa số 10, p chứa địa chỉ của x (0x1000), nên có mũi tên từ p tới x.","stack":[{"id":"x","ten":"x","kieu":"int","giaTri":10,"dia":"0x1000","khung":"main"},{"id":"p","ten":"p","kieu":"int *","giaTri":"0x1000","dia":"0x1004","khung":"main"}],"heap":[],"mauTen":[{"tu":"p","den":"x"}],"dauRa":""},{"dong":5,"moTa":"*p = 25 nghĩa là \"đi theo mũi tên rồi ghi 25\". x đổi từ 10 thành 25 dù không viết x = 25.","stack":[{"id":"x","ten":"x","kieu":"int","giaTri":25,"dia":"0x1000","khung":"main"},{"id":"p","ten":"p","kieu":"int *","giaTri":"0x1000","dia":"0x1004","khung":"main"}],"heap":[],"mauTen":[{"tu":"p","den":"x"}],"dauRa":""},{"dong":6,"moTa":"printf in x. Vì x đã bị đổi qua con trỏ nên in ra 25.","stack":[{"id":"x","ten":"x","kieu":"int","giaTri":25,"dia":"0x1000","khung":"main"},{"id":"p","ten":"p","kieu":"int *","giaTri":"0x1000","dia":"0x1004","khung":"main"}],"heap":[],"mauTen":[{"tu":"p","den":"x"}],"dauRa":"25\n"},{"dong":7,"moTa":"main kết thúc, các biến trên stack được thu hồi.","stack":[{"id":"x","ten":"x","kieu":"int","giaTri":25,"dia":"0x1000","khung":"main"},{"id":"p","ten":"p","kieu":"int *","giaTri":"0x1000","dia":"0x1004","khung":"main"}],"heap":[],"mauTen":[{"tu":"p","den":"x"}],"dauRa":"25\n"}],"baiHocId":"con-tro-va-bo-nho"}
