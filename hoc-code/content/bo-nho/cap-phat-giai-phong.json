{"id":"cap-phat-giai-phong","tieuDe":"Cấp phát, dùng, giải phóng","baiHoc":"Bộ nhớ động","moTaNgan":"malloc xin một khối trên heap; free trả lại khi dùng xong.","chuanC":true,"maNguon":["#include <stdio.h>","#include <stdlib.h>","int main(void) {","    int *p = malloc(sizeof(int));","    *p = 42;","    printf(\"%d\\n\", *p);","    free(p);","    p = NULL;","    return 0;","}"],"buoc":[{"dong":0,"moTa":"Chưa chạy dòng nào. (Địa chỉ trên màn hình chỉ là số minh họa, không phải địa chỉ thật.)","stack":[],"heap":[],"mauTen":[],"dauRa":""},{"dong":4,"moTa":"malloc xin 4 byte trên heap và trả về địa chỉ khối. p (trên stack) trỏ tới khối đó. Khối mới chưa có giá trị (\"?\").","stack":[{"id":"p","ten":"p","kieu":"int *","giaTri":"0x5000","dia":"0x1000","khung":"main"}],"heap":[{"id":"h1","kichThuoc":4,"trangThai":"dangDung","dia":"0x5000","noiDung":[{"giaTri":"?"}]}],"mauTen":[{"tu":"p","den":"h1"}],"dauRa":""},{"dong":5,"moTa":"*p = 42 đi theo mũi tên và ghi 42 vào khối trên heap.","stack":[{"id":"p","ten":"p","kieu":"int *","giaTri":"0x5000","dia":"0x1000","khung":"main"}],"heap":[{"id":"h1","kichThuoc":4,"trangThai":"dangDung","dia":"0x5000","noiDung":[{"giaTri":42}]}],"mauTen":[{"tu":"p","den":"h1"}],"dauRa":""},{"dong":6,"moTa":"printf in *p: đọc giá trị trong khối, in 42.","stack":[{"id":"p","ten":"p","kieu":"int *","giaTri":"0x5000","dia":"0x1000","khung":"main"}],"heap":[{"id":"h1","kichThuoc":4,"trangThai":"dangDung","dia":"0x5000","noiDung":[{"giaTri":42}]}],"mauTen":[{"tu":"p","den":"h1"}],"dauRa":"42\n"},{"dong":7,"moTa":"free(p) trả khối về cho hệ thống. Khối đã giải phóng, nhưng p vẫn giữ địa chỉ cũ: p trở thành con trỏ treo, không được đọc hay ghi qua p nữa.","stack":[{"id":"p","ten":"p","kieu":"int *","giaTri":"0x5000","dia":"0x1000","khung":"main"}],"heap":[{"id":"h1","kichThuoc":4,"trangThai":"daGiaiPhong","dia":"0x5000","noiDung":[{"giaTri":42}]}],"mauTen":[{"tu":"p","den":"h1"}],"canhBao":{"loai":"conTroTreo","thongDiep":"p vẫn trỏ vào khối đã free (con 